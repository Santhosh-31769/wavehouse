# Hosted Vercel setup; keep the real values in Vercel Environment Variables.
BLOB_READ_WRITE_TOKEN=
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_HOST:6379
WAVEHOUSE_SESSION_SECRET=use-a-random-secret-at-least-32-characters-long
WAVEHOUSE_ADMIN_EMAIL=admin@example.com
WAVEHOUSE_ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters
WAVEHOUSE_ADMIN_NAME=Studio Admin
WAVEHOUSE_ADMIN_USERNAME=studioadmin
